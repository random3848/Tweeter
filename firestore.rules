rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Whether someone is logged in, not a guest.
    function isLoggedIn() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Whether user [uid] is logged in, not a guest.
    function isLoggedInAs(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    // The path of the logged-in user's like of post [postId].
    function likePath(postId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/likes/$(postId);
    }

    // The like count of post [postId] before and after the request, which can be a batch.
    function likeCountBefore(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.get('likeCount', 0);
    }

    function likeCountAfter(postId) {
      return getAfter(/databases/$(database)/documents/posts/$(postId)).data.get('likeCount', 0);
    }

    // The path of the logged-in user's vote on the animal of post [postId].
    function votePath(postId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/votes/$(postId);
    }

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    // Whether [name] can name an animal: text of 1 to 100 characters.
    function isAnimalName(name) {
      return name is string && name.size() > 0 && name.size() <= 100;
    }

    // Whether the request, which can be a batch or transaction, changes the vote counts of post
    // [postId], which the rules of /posts/{postId} allow only by the logged-in user's vote on it.
    function changesVoteCounts(postId) {
      return getAfter(postPath(postId)).data.get('voteCounts', {})
          != get(postPath(postId)).data.get('voteCounts', {});
    }

    // Whether [vote], a vote on post [postId], counts: the post still exists, in the voting round
    // the vote was cast in.
    function countsInRound(vote, postId) {
      return exists(postPath(postId))
          && vote.round == get(postPath(postId)).data.get('voteRound', 0);
    }

    // The most animals a post's vote counts can hold, as MAX_VOTED_ANIMALS in the app. With it,
    // and an animal taken out of them once its last vote goes, a voter can't grow them without
    // bound by moving their vote through ever more names.
    function maxVotedAnimals() {
      return 50;
    }

    // Whether the vote counts [after] hold one more vote for [animal] than [before].
    function givesVote(before, after, animal) {
      return after.get(animal, 0) == before.get(animal, 0) + 1;
    }

    // Whether the vote counts [after] hold one vote less for [animal] than [before], leaving
    // [animal] out once it has none, rather than at 0.
    function takesVote(before, after, animal) {
      return (before.get(animal, 0) == 1 && !(animal in after))
          || (before.get(animal, 0) > 1 && after.get(animal, 0) == before.get(animal, 0) - 1);
    }

    // Whether the vote counts [after] hold at most maxVotedAnimals() animals, or at least no more
    // than [before], whose animals can keep their votes.
    function staysWithinAnimalCap(before, after) {
      return after.size() <= maxVotedAnimals() || after.size() <= before.size();
    }

    // Whether the vote counts [after] hold one more vote for [animal] than [before], and are
    // otherwise the same.
    function addsVote(before, after, animal) {
      return after.diff(before).affectedKeys().hasOnly([animal])
          && givesVote(before, after, animal)
          && staysWithinAnimalCap(before, after);
    }

    // Whether the vote counts [after] hold one vote less for [animal] than [before], and are
    // otherwise the same.
    function removesVote(before, after, animal) {
      return after.diff(before).affectedKeys().hasOnly([animal])
          && takesVote(before, after, animal);
    }

    // Whether the vote counts [after] hold one vote moved from animal [from] to animal [to],
    // compared with [before], and are otherwise the same.
    function movesVote(before, after, from, to) {
      return from != to
          && after.diff(before).affectedKeys().hasOnly([from, to])
          && takesVote(before, after, from)
          && givesVote(before, after, to)
          && staysWithinAnimalCap(before, after);
    }

    // The fields and limits match ProfileDocument and UserProfile in the app.
    // Allows reading follower relationships across users for following counts.
    match /{path=**}/followers/{followerUid} {
      allow read: if request.auth != null;
    }
    match /users/{uid} {
      allow read: if request.auth != null;

        // Only the logged-in user (not a guest) can save their own profile.
        allow create, update: if request.auth != null
                              && request.auth.token.firebase.sign_in_provider != 'anonymous'
                              && request.auth.uid == uid
                              && request.resource.data.keys().hasOnly([
                                   'displayName', 'bio', 'photoUrl'
                                 ])
                              && request.resource.data.keys().hasAll([
                                   'displayName', 'bio', 'photoUrl'
                                 ])
                              && request.resource.data.displayName is string
                              && request.resource.data.displayName.size() > 0
                              && request.resource.data.displayName.size() <= 30
                              && request.resource.data.bio is string
                            && request.resource.data.displayName.size() <= 30
                            && request.resource.data.bio is string
                            && request.resource.data.bio.size() <= 150
                            && request.resource.data.photoUrl is string
                            && (request.resource.data.photoUrl == ''
                                || request.resource.data.photoUrl.matches('https://.*'));

      // A follower document identifies who follows this user.
      match /followers/{followerUid} {
        allow read: if request.auth != null;

        // Registered users can follow others only as themselves.
        allow create: if request.auth != null
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.auth.uid == followerUid
                      && followerUid != uid
                      && request.resource.data.keys().hasOnly([]);

        // Users can remove only their own following relationship.
        allow delete: if request.auth != null
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.auth.uid == followerUid;
      }

      // The posts the user liked: an empty document per post, named by its ID, which
      // FirestoreLikeRepository adds or deletes in one batch with the post's like count.
      match /likes/{postId} {
        allow read: if isLoggedInAs(uid);
        allow create: if isLoggedInAs(uid)
                      && request.resource.data.keys().size() == 0
                      && likeCountAfter(postId) == likeCountBefore(postId) + 1;
        allow delete: if isLoggedInAs(uid)
                      && likeCountAfter(postId) == likeCountBefore(postId) - 1;
      }

      // The user's votes on what animal posts show: a document per post, named by its ID,
      // holding the animal they voted for and the post's voting round it was cast in, as
      // VoteDocument describes. FirestoreVoteRepository saves it in one transaction with the
      // post's vote counts, whose rule (see /posts/{postId}) checks they change by just this vote.
      // A vote from an earlier round no longer counts, so its voter can delete it alone. The
      // poster's vote is the post's animal, so they can't add one.
      match /votes/{postId} {
        allow read: if isLoggedInAs(uid);
        allow create, update: if isLoggedInAs(uid)
                              && request.resource.data.keys().hasOnly(['animal', 'round'])
                              && request.resource.data.keys().hasAll(['animal', 'round'])
                              && isAnimalName(request.resource.data.animal)
                              && get(postPath(postId)).data.get('authorUid', '') != uid
                              && request.resource.data.round
                                   == get(postPath(postId)).data.get('voteRound', 0)
                              && changesVoteCounts(postId);
        allow delete: if isLoggedInAs(uid)
                      && (!countsInRound(resource.data, postId) || changesVoteCounts(postId));
      }

      // The posts the user saved to view later: an empty document per post, named by its ID,
      // which FirestoreBookmarkRepository adds or deletes. Only the user sees or changes them, only
      // posts that exist can be saved, and saving a post doesn't change it.
      match /bookmarks/{postId} {
        allow read: if isLoggedInAs(uid);
        allow create: if isLoggedInAs(uid)
                      && request.resource.data.keys().size() == 0
                      && exists(/databases/$(database)/documents/posts/$(postId));
        allow delete: if isLoggedInAs(uid);
      }
    }

    // The fields match PostDocument in the app.
    match /posts/{postId} {
      // Guests (anonymous sessions) can read posts but not share them.
      allow read: if request.auth != null;

      // Liking a post adds or takes one from its like count, in the same batch as the user's
      // like (see /users/{uid}/likes).
      allow update: if isLoggedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['likeCount'])
                    && (isLiking(postId) || isUnliking(postId));

      // Voting on the post's animal: the logged-in user's vote, saved in the same transaction
      // (see /users/{uid}/votes), moves between its vote counts. The poster's vote is the post's
      // animal, so they can't vote.
      allow update: if isLoggedIn()
                    && resource.data.get('authorUid', '') != request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['voteCounts'])
                    && isTallyingVote(postId);

      // Reclassifying: the author names another animal, which starts the next voting round with
      // no votes and no confidence, both of which were about the animal it named before.
      allow update: if isLoggedIn()
                    && resource.data.get('authorUid', '') == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['animalType', 'confidence', 'voteCounts', 'voteRound'])
                    && isAnimalName(request.resource.data.animalType)
                    && request.resource.data.animalType != resource.data.get('animalType', '')
                    && request.resource.data.voteCounts == {}
                    && request.resource.data.voteRound == resource.data.get('voteRound', 0) + 1
                    && !request.resource.data.keys().hasAny(['confidence']);

      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.keys().hasOnly([
                         'authorUid', 'username', 'avatarInitials', 'locationName', 'latitude',
                         'longitude', 'imageUri', 'caption', 'likeCount', 'commentCount',
                         'timestamp', 'animalType', 'confidence', 'voteCounts', 'voteRound'
                       ])
                    && request.resource.data.keys().hasAll([
                         'authorUid', 'username', 'latitude', 'longitude', 'imageUri', 'timestamp'
                       ])
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.username is string
                    && request.resource.data.username.size() > 0
                    && request.resource.data.latitude is number
                    && request.resource.data.latitude >= -90
                    && request.resource.data.latitude <= 90
                    && request.resource.data.longitude is number
                    && request.resource.data.longitude >= -180
                    && request.resource.data.longitude <= 180
                    && request.resource.data.imageUri is string
                    && request.resource.data.imageUri.matches('https://.*')
                    && request.resource.data.get('likeCount', 0) == 0
                    && request.resource.data.get('commentCount', 0) == 0
                    && request.resource.data.get('voteCounts', {}) == {}
                    && request.resource.data.get('voteRound', 0) == 0
                    // Set by Firestore when it receives the post, not by the phone's clock.
                    && request.resource.data.timestamp == request.time;
                    // Only the post's author (not a guest) can delete it.
      allow delete: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && resource.data.authorUid == request.auth.uid;

      // Guests can read a post's comments; only logged-in users can write one, as themselves.
      // The fields and limits match Comment and FirestoreCommentRepository in the app.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if isLoggedIn()
                      && request.resource.data.keys().hasOnly([
                           'authorUid', 'username', 'text', 'timestamp'
                         ])
                      && request.resource.data.keys().hasAll([
                           'authorUid', 'username', 'text', 'timestamp'
                         ])
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.username is string
                      && request.resource.data.username.size() > 0
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      // Set by Firestore when it receives the comment, not by the phone's clock.
                      && request.resource.data.timestamp == request.time
                      && exists(/databases/$(database)/documents/posts/$(postId));
      }

      function isLiking(postId) {
        return request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
            && !exists(likePath(postId))
            && existsAfter(likePath(postId));
      }

      function isUnliking(postId) {
        return request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
            && exists(likePath(postId))
            && !existsAfter(likePath(postId));
      }

      // Whether the vote counts change by just the logged-in user's vote: the animal that their
      // vote of the post's current round named before the request, if any, loses one, and the
      // animal it names after the request, if any, gains one.
      function isTallyingVote(postId) {
        let round = resource.data.get('voteRound', 0);
        let before = resource.data.get('voteCounts', {});
        let after = request.resource.data.get('voteCounts', {});
        let hadVote = exists(votePath(postId)) && get(votePath(postId)).data.round == round;
        let hasVote = existsAfter(votePath(postId))
            && getAfter(votePath(postId)).data.round == round;
        return (!hadVote && hasVote
                && addsVote(before, after, getAfter(votePath(postId)).data.animal))
            || (hadVote && !hasVote
                && removesVote(before, after, get(votePath(postId)).data.animal))
            || (hadVote && hasVote
                && movesVote(before, after, get(votePath(postId)).data.animal,
                             getAfter(votePath(postId)).data.animal));
      }
    }

    // Reports of posts and users, which the team reviews in the Firebase console. Logged-in users
    // send them as themselves and not about themselves, and a post's report names its author. A
    // report's ID names the reporter, the reported user and the post, or 'profile' when there's
    // none (see Report.id), so each user keeps one report per post or user: reporting it again
    // replaces the earlier one. Nobody can read or delete a report from the app. The fields and
    // limits match Report and FirestoreReportRepository.
    match /reports/{reportId} {
      allow create: if isValidReport(reportId);

      allow update: if resource.data.reporterUid == request.auth.uid
                    && isValidReport(reportId);

      function isValidReport(reportId) {
        return isLoggedIn()
            && request.resource.data.keys().hasOnly([
                 'reporterUid', 'reportedUid', 'postId', 'reason', 'details', 'timestamp'
               ])
            && request.resource.data.keys().hasAll([
                 'reporterUid', 'reportedUid', 'postId', 'reason', 'details', 'timestamp'
               ])
            && request.resource.data.reporterUid == request.auth.uid
            && request.resource.data.reportedUid is string
            && request.resource.data.reportedUid.size() > 0
            && request.resource.data.reportedUid.size() <= 128
            && request.resource.data.reportedUid != request.auth.uid
            && request.resource.data.postId is string
            && request.resource.data.postId.size() <= 128
            && reportId == reportIdOf(request.resource.data)
            && isByPostAuthor(request.resource.data)
            && request.resource.data.reason in [
                 'SPAM', 'HARASSMENT', 'SEXUAL_CONTENT', 'VIOLENCE', 'OTHER'
               ]
            && request.resource.data.details is string
            && request.resource.data.details.size() <= 500
            // Set by Firestore when it receives the report, not by the phone's clock.
            && request.resource.data.timestamp == request.time;
      }

      // The ID Report.id gives [report].
      function reportIdOf(report) {
        return report.reporterUid + '_' + report.reportedUid + '_' +
               (report.postId == '' ? 'profile' : report.postId);
      }

      // Whether the user [report] reports wrote its post, if it's about one.
      function isByPostAuthor(report) {
        return report.postId == ''
            || get(/databases/$(database)/documents/posts/$(report.postId)).data.authorUid ==
                 report.reportedUid;
      }
    }
  }
}