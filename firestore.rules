rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Whether someone is logged in, not a guest.
    function isLoggedIn() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Whether user [uid] is logged in, not a guest.
    function isLoggedInAs(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    // The path of the logged-in user's like of post [postId].
    function likePath(postId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/likes/$(postId);
    }

    // The like count of post [postId] before and after the request, which can be a batch.
    function likeCountBefore(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.get('likeCount', 0);
    }

    function likeCountAfter(postId) {
      return getAfter(/databases/$(database)/documents/posts/$(postId)).data.get('likeCount', 0);
    }

    // The fields and limits match ProfileDocument and UserProfile in the app.
    // Allows reading follower relationships across users for following counts.
    match /{path=**}/followers/{followerUid} {
      allow read: if request.auth != null;
    }
    match /users/{uid} {
      allow read: if request.auth != null;

        // Only the logged-in user (not a guest) can save their own profile.
        allow create, update: if request.auth != null
                              && request.auth.token.firebase.sign_in_provider != 'anonymous'
                              && request.auth.uid == uid
                              && request.resource.data.keys().hasOnly([
                                   'displayName', 'bio', 'photoUrl'
                                 ])
                              && request.resource.data.keys().hasAll([
                                   'displayName', 'bio', 'photoUrl'
                                 ])
                              && request.resource.data.displayName is string
                              && request.resource.data.displayName.size() > 0
                              && request.resource.data.displayName.size() <= 30
                              && request.resource.data.bio is string
                            && request.resource.data.displayName.size() <= 30
                            && request.resource.data.bio is string
                            && request.resource.data.bio.size() <= 150
                            && request.resource.data.photoUrl is string
                            && (request.resource.data.photoUrl == ''
                                || request.resource.data.photoUrl.matches('https://.*'));

      // A follower document identifies who follows this user.
      match /followers/{followerUid} {
        allow read: if request.auth != null;

        // Registered users can follow others only as themselves.
        allow create: if request.auth != null
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.auth.uid == followerUid
                      && followerUid != uid
                      && request.resource.data.keys().hasOnly([]);

        // Users can remove only their own following relationship.
        allow delete: if request.auth != null
                      && request.auth.token.firebase.sign_in_provider != 'anonymous'
                      && request.auth.uid == followerUid;
      }

      // The posts the user liked: an empty document per post, named by its ID, which
      // FirestoreLikeRepository adds or deletes in one batch with the post's like count.
      match /likes/{postId} {
        allow read: if isLoggedInAs(uid);
        allow create: if isLoggedInAs(uid)
                      && request.resource.data.keys().size() == 0
                      && likeCountAfter(postId) == likeCountBefore(postId) + 1;
        allow delete: if isLoggedInAs(uid)
                      && likeCountAfter(postId) == likeCountBefore(postId) - 1;
      }
    }

    // The fields match PostDocument in the app.
    match /posts/{postId} {
      // Guests (anonymous sessions) can read posts but not share them.
      allow read: if request.auth != null;

      // Posts can't be edited yet; liking one is the only change, which adds or takes
      // one from its like count, in the same batch as the user's like (see /users/{uid}/likes).
      allow update: if isLoggedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['likeCount'])
                    && (isLiking(postId) || isUnliking(postId));

      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.keys().hasOnly([
                         'authorUid', 'username', 'avatarInitials', 'locationName', 'latitude',
                         'longitude', 'imageUri', 'caption', 'likeCount', 'commentCount',
                         'timestamp', 'animalType', 'confidence'
                       ])
                    && request.resource.data.keys().hasAll([
                         'authorUid', 'username', 'latitude', 'longitude', 'imageUri', 'timestamp'
                       ])
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.username is string
                    && request.resource.data.username.size() > 0
                    && request.resource.data.latitude is number
                    && request.resource.data.latitude >= -90
                    && request.resource.data.latitude <= 90
                    && request.resource.data.longitude is number
                    && request.resource.data.longitude >= -180
                    && request.resource.data.longitude <= 180
                    && request.resource.data.imageUri is string
                    && request.resource.data.imageUri.matches('https://.*')
                    && request.resource.data.get('likeCount', 0) == 0
                    && request.resource.data.get('commentCount', 0) == 0
                    // Set by Firestore when it receives the post, not by the phone's clock.
                    && request.resource.data.timestamp == request.time;
                    // Only the post's author (not a guest) can delete it.
      allow delete: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && resource.data.authorUid == request.auth.uid;

      // Guests can read a post's comments; only logged-in users can write one, as themselves.
      // The fields and limits match Comment and FirestoreCommentRepository in the app.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if isLoggedIn()
                      && request.resource.data.keys().hasOnly([
                           'authorUid', 'username', 'text', 'timestamp'
                         ])
                      && request.resource.data.keys().hasAll([
                           'authorUid', 'username', 'text', 'timestamp'
                         ])
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.username is string
                      && request.resource.data.username.size() > 0
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      // Set by Firestore when it receives the comment, not by the phone's clock.
                      && request.resource.data.timestamp == request.time
                      && exists(/databases/$(database)/documents/posts/$(postId));
      }

      function isLiking(postId) {
        return request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
            && !exists(likePath(postId))
            && existsAfter(likePath(postId));
      }

      function isUnliking(postId) {
        return request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
            && exists(likePath(postId))
            && !existsAfter(likePath(postId));
      }
    }

    // Reports of posts and users, which the team reviews in the Firebase console. Logged-in users
    // send them as themselves and not about themselves, and a post's report names its author. A
    // report's ID names the reporter, the reported user and the post, or 'profile' when there's
    // none (see Report.id), so each user keeps one report per post or user: reporting it again
    // replaces the earlier one. Nobody can read or delete a report from the app. The fields and
    // limits match Report and FirestoreReportRepository.
    match /reports/{reportId} {
      allow create: if isValidReport(reportId);

      allow update: if resource.data.reporterUid == request.auth.uid
                    && isValidReport(reportId);

      function isValidReport(reportId) {
        return isLoggedIn()
            && request.resource.data.keys().hasOnly([
                 'reporterUid', 'reportedUid', 'postId', 'reason', 'details', 'timestamp'
               ])
            && request.resource.data.keys().hasAll([
                 'reporterUid', 'reportedUid', 'postId', 'reason', 'details', 'timestamp'
               ])
            && request.resource.data.reporterUid == request.auth.uid
            && request.resource.data.reportedUid is string
            && request.resource.data.reportedUid.size() > 0
            && request.resource.data.reportedUid.size() <= 128
            && request.resource.data.reportedUid != request.auth.uid
            && request.resource.data.postId is string
            && request.resource.data.postId.size() <= 128
            && reportId == reportIdOf(request.resource.data)
            && isByPostAuthor(request.resource.data)
            && request.resource.data.reason in [
                 'SPAM', 'HARASSMENT', 'SEXUAL_CONTENT', 'VIOLENCE', 'OTHER'
               ]
            && request.resource.data.details is string
            && request.resource.data.details.size() <= 500
            // Set by Firestore when it receives the report, not by the phone's clock.
            && request.resource.data.timestamp == request.time;
      }

      // The ID Report.id gives [report].
      function reportIdOf(report) {
        return report.reporterUid + '_' + report.reportedUid + '_' +
               (report.postId == '' ? 'profile' : report.postId);
      }

      // Whether the user [report] reports wrote its post, if it's about one. A profile's report
      // can't check that its user exists: until a user saves their profile they have no
      // /users/{uid} document, though their posts open their profile and its Report button.
      function isByPostAuthor(report) {
        return report.postId == ''
            || get(/databases/$(database)/documents/posts/$(report.postId)).data.authorUid ==
                 report.reportedUid;
      }
    }
  }
}